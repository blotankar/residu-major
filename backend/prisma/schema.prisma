generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  VETERINARIAN
  COLLECTION_CENTRE
  FACTORY
  AUTHORITY
  CONSUMER
}

enum MilkBatchStatus {
  SAFE
  HOLD
  PROCESSING
  DISPATCHED
}

enum ProcessingBatchStatus {
  PROCESSING
  COMPLETED
  DISPATCHED
  HOLD
}

enum QualityTestResult {
  PASS
  FAIL
  INCONCLUSIVE
}

enum QualityInspectionStatus {
  ACCEPTED
  ON_HOLD
  REJECTED
}

enum ProductLotStatus {
  AVAILABLE
  HOLD
  RECALLED
  DEPLETED
}

enum InventoryMovementType {
  PRODUCTION_OUTPUT
  DISPATCH
}

enum DispatchStatus {
  DISPATCHED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  organization String?

  farmer             Farmer?
  veterinarian       Veterinarian?
  collectionCentre   CollectionCentre?
  factory            Factory?
  authority          Authority?
  factoryReceipts    FactoryMilkBatchReceipt[] @relation("FactoryReceiptRecorder")
  qualityInspections MilkQualityInspection[]   @relation("QualityInspector")
  productionRuns     ProcessingBatch[]         @relation("ProductionOperator")
  dispatches         Dispatch[]                @relation("DispatchCreator")
  inventoryMovements InventoryMovement[]       @relation("InventoryRecorder")
  factoryIntakeRegistrations FactoryMilkBatchIntake[] @relation("FactoryIntakeRegistrar")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Farmer {
  id      String  @id @default(uuid())
  userId  String  @unique
  village String
  phone   String?

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cattle Cattle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("farmers")
}

model Veterinarian {
  id        String  @id @default(uuid())
  userId    String  @unique
  name      String
  licenseNo String  @unique
  phone     String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  treatments Treatment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("veterinarians")
}

model CollectionCentre {
  id      String  @id @default(uuid())
  userId  String  @unique
  name    String
  code    String  @unique
  village String?
  address String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milkBatches MilkBatch[]
  cattle      Cattle[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  collectionCentreCattles CollectionCentreCattle[]

  @@map("collection_centres")
}

model Factory {
  id      String  @id @default(uuid())
  userId  String  @unique
  name    String
  code    String  @unique
  address String?

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingBatches ProcessingBatch[]
  milkReceipts      FactoryMilkBatchReceipt[]
  dispatches        Dispatch[]
  milkBatchIntakes FactoryMilkBatchIntake[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("factories")
}

model Authority {
  id           String  @id @default(uuid())
  userId       String  @unique
  name         String
  organization String?
  designation  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authorities")
}

model Cattle {
  id          String    @id @default(uuid())
  cattleId    String
  name        String?
  breed       String?
  dateOfBirth DateTime?
  sex         String?

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  collectionCentreId String?
  collectionCentre   CollectionCentre? @relation(fields: [collectionCentreId], references: [id])

  treatments       Treatment[]
  milkBatchAnimals MilkBatchAnimal[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  collectionCentreCattle CollectionCentreCattle?

  @@unique([farmerId, cattleId])
  @@index([collectionCentreId])
  @@map("Cattle")
}



model Treatment {
  id             String @id @default(uuid())
  cattleId       String
  veterinarianId String

  medicineName   String
  medicineMrlId  String?
  dosage         String?
  administeredAt DateTime
  withdrawalEnds DateTime?
  reason         String?

  cattle       Cattle       @relation(fields: [cattleId], references: [id])
  veterinarian Veterinarian @relation(fields: [veterinarianId], references: [id])
  medicineMrl  MedicineMRL? @relation(fields: [medicineMrlId], references: [id])

  createdAt DateTime @default(now())

  @@map("treatments")
}

model MilkBatch {
  id      String @id @default(uuid())
  batchId String @unique

  collectionCentreId String
  date               DateTime
  volumeL            Float
  status             MilkBatchStatus @default(SAFE)

  collectionCentre    CollectionCentre         @relation(fields: [collectionCentreId], references: [id])
  contributingAnimals MilkBatchAnimal[]
  processingBatches   ProcessingMilkBatch[]
  factoryReceipt      FactoryMilkBatchReceipt?
  qualityInspections  MilkQualityInspection[]
  factoryIntake FactoryMilkBatchIntake?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("milk_batches")
}

model FactoryMilkBatchIntake {
  id          String   @id @default(uuid())
  factoryId   String
  milkBatchId String   @unique
  addedAt     DateTime @default(now())
  addedByUserId String

  factory Factory   @relation(fields: [factoryId], references: [id])
  milkBatch MilkBatch @relation(fields: [milkBatchId], references: [id])
  addedBy User @relation("FactoryIntakeRegistrar", fields: [addedByUserId], references: [id])
  
  @@index([factoryId, addedAt])
  @@map("factory_milk_batch_intakes")
}

model FactoryMilkBatchReceipt {
  id                String   @id @default(uuid())
  milkBatchId       String   @unique
  factoryId         String
  receivedQuantityL Decimal  @db.Decimal(12, 3)
  receivedAt        DateTime
  discrepancyNote   String?
  receivedByUserId  String
  createdAt         DateTime @default(now())

  milkBatch  MilkBatch @relation(fields: [milkBatchId], references: [id])
  factory    Factory   @relation(fields: [factoryId], references: [id])
  receivedBy User      @relation("FactoryReceiptRecorder", fields: [receivedByUserId], references: [id])

  @@index([factoryId, receivedAt])
  @@map("factory_milk_batch_receipts")
}

model MilkQualityInspection {
  id                 String                  @id @default(uuid())
  milkBatchId        String
  inspectorUserId    String
  temperatureC       Decimal                 @db.Decimal(7, 3)
  fatPercent         Decimal                 @db.Decimal(7, 3)
  snfPercent         Decimal                 @db.Decimal(7, 3)
  acidityPercent     Decimal                 @db.Decimal(7, 3)
  adulterationResult QualityTestResult
  status             QualityInspectionStatus
  remarks            String?
  inspectedAt        DateTime                @default(now())
  createdAt          DateTime                @default(now())

  milkBatch MilkBatch @relation(fields: [milkBatchId], references: [id])
  inspector User      @relation("QualityInspector", fields: [inspectorUserId], references: [id])

  @@index([milkBatchId, inspectedAt])
  @@map("milk_quality_inspections")
}

model MilkBatchAnimal {
  id          String @id @default(uuid())
  milkBatchId String
  cattleId    String

  milkBatch MilkBatch @relation(fields: [milkBatchId], references: [id])
  cattle    Cattle    @relation(fields: [cattleId], references: [id])

  @@unique([milkBatchId, cattleId])
  @@map("milk_batch_animals")
}

model ProcessingBatch {
  id      String @id @default(uuid())
  batchId String @unique

  factoryId String
  date      DateTime
  volumeL   Float
  product   String
  packs     Int

  status         ProcessingBatchStatus @default(PROCESSING)
  operatorUserId String?
  inputVolumeL   Decimal?              @db.Decimal(12, 3)
  outputVolumeL  Decimal?              @db.Decimal(12, 3)
  wastageL       Decimal?              @db.Decimal(12, 3)
  completedAt    DateTime?

  factory           Factory               @relation(fields: [factoryId], references: [id])
  operator          User?                 @relation("ProductionOperator", fields: [operatorUserId], references: [id])
  sourceMilkBatches ProcessingMilkBatch[]
  packages          Package[]
  productLots       ProductLot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("processing_batches")
}

model ProductLot {
  id                String           @id @default(uuid())
  lotId             String           @unique
  processingBatchId String
  productName       String
  producedQuantityL Decimal          @db.Decimal(12, 3)
  currentQuantityL  Decimal          @db.Decimal(12, 3)
  status            ProductLotStatus @default(AVAILABLE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  processingBatch ProcessingBatch     @relation(fields: [processingBatchId], references: [id])
  movements       InventoryMovement[]
  dispatchItems   DispatchItem[]

  @@index([processingBatchId])
  @@index([status, createdAt])
  @@map("product_lots")
}

model InventoryMovement {
  id               String                @id @default(uuid())
  productLotId     String
  dispatchId       String?
  recordedByUserId String
  movementType     InventoryMovementType
  quantityL        Decimal               @db.Decimal(12, 3)
  reference        String?
  createdAt        DateTime              @default(now())

  productLot ProductLot @relation(fields: [productLotId], references: [id])
  dispatch   Dispatch?  @relation(fields: [dispatchId], references: [id])
  recordedBy User       @relation("InventoryRecorder", fields: [recordedByUserId], references: [id])

  @@index([productLotId, createdAt])
  @@index([dispatchId])
  @@map("inventory_movements")
}

model Dispatch {
  id               String         @id @default(uuid())
  dispatchId       String         @unique
  factoryId        String
  destination      String
  dispatchedAt     DateTime
  transportDetails String?
  status           DispatchStatus @default(DISPATCHED)
  createdByUserId  String
  createdAt        DateTime       @default(now())

  factory   Factory             @relation(fields: [factoryId], references: [id])
  createdBy User                @relation("DispatchCreator", fields: [createdByUserId], references: [id])
  items     DispatchItem[]
  movements InventoryMovement[]

  @@index([factoryId, dispatchedAt])
  @@map("factory_dispatches")
}

model DispatchItem {
  id           String  @id @default(uuid())
  dispatchId   String
  productLotId String
  quantityL    Decimal @db.Decimal(12, 3)

  dispatch   Dispatch   @relation(fields: [dispatchId], references: [id])
  productLot ProductLot @relation(fields: [productLotId], references: [id])

  @@unique([dispatchId, productLotId])
  @@index([productLotId])
  @@map("factory_dispatch_items")
}

model ProcessingMilkBatch {
  id                String @id @default(uuid())
  processingBatchId String
  milkBatchId       String

  processingBatch ProcessingBatch @relation(fields: [processingBatchId], references: [id])
  milkBatch       MilkBatch       @relation(fields: [milkBatchId], references: [id])

  @@unique([processingBatchId, milkBatchId])
  @@map("processing_milk_batches")
}

model Package {
  id        String @id @default(uuid())
  packageId String @unique

  processingBatchId String
  productName       String
  volumeMl          Int

  processingBatch ProcessingBatch @relation(fields: [processingBatchId], references: [id])

  createdAt DateTime @default(now())

  @@map("packages")
}

model TraceabilityEvent {
  id String @id @default(uuid())

  eventType  String
  entityType String
  entityId   String

  payload Json

  blockchainTxId   String?
  blockNumber      String?
  blockchainStatus String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
  @@map("traceability_events")
}

model MedicineMRL {
  id                 String  @id @default(uuid())
  medicineName       String  @unique
  activeIngredient   String?
  mrlValue           Float?
  unit               String?
  sourceTitle        String?
  sourceUrl          String?
  regulatoryStatus   String?
  unitVerification   String?
  isDashboardEnabled Boolean @default(true)

  treatments Treatment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medicine_mrls")
}

model CollectionCentreCattle {
  id                 String @id @default(uuid())
  collectionCentreId String
  cattleId           String @unique

  collectionCentre CollectionCentre @relation(fields: [collectionCentreId], references: [id], onDelete: Cascade)
  cattle           Cattle           @relation(fields: [cattleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([collectionCentreId])
  @@map("collection_centre_cattle")
}
